# Vitrinaki independent storefronts
VITRINAKI_STOREFRONT_URL=http://localhost:3100
VITRINAKI_STUDIO_URL=http://localhost:7001
VITRINAKI_DEFAULT_LOCALE=gr
# Set this to the hosting target configured for custom-domain CNAME records.
VITRINAKI_CUSTOM_DOMAIN_TARGET=

# Stripe billing. Create recurring prices for each plan/interval and one-time prices for setup.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_SETUP_ASSISTED=
STRIPE_PRICE_SETUP_DONE_FOR_YOU=
# Premium templates add-on: monthly recurring price (9 EUR) and one-off activation (110 EUR). Free on Business.
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ACTIVATION=

# Card payments at checkout: direct charges on each shop's own Stripe account
# (Stripe Connect, Standard accounts). Uses STRIPE_SECRET_KEY above. The secret
# below belongs to the Connect webhook endpoint (/webhooks/stripe-connect,
# "Events on connected accounts"); STRIPE_WEBHOOK_SECRET stays the billing one.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Optional platform fee in percent of each card payment (0 = none).
STRIPE_APPLICATION_FEE_PERCENT=
# Optional default description on the shop's payments.
STRIPE_PAYMENT_DESCRIPTION=

# Public platform hostnames (comma separated; include production and www/root variants).
VITRINAKI_PLATFORM_HOSTS=
# Κωδικοί που ενεργοποιούν συνδρομή χωρίς πληρωμή: CODE:plan:days (days προαιρετικό)
# plan: starter, growth, pro ή business
VITRINAKI_PROMO_CODES=VITRINAKI-TEST:pro
